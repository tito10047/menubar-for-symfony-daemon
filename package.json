{
  "name": "symfony-menubar-daemon",
  "version": "1.3.0",
  "description": "Helper service for the Menubar for Symfony GNOME Shell extension: runs the Symfony CLI and exposes it on the session bus",
  "license": "GPL-2.0-or-later",
  "author": "Jozef Môstka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tito10047/symfony-menubar-daemon.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest tests/unit",
    "test:integration": "RUN_INTEGRATION=1 jest tests/integration --runInBand",
    "test:dbus": "tests/dbus/run.sh",
    "check": "npm run typecheck && npm test && npm run build && npm run test:dbus",
    "install-daemon": "npm run build && ./install.sh"
  },
  "devDependencies": {
    "@girs/gio-2.0": "^2.88.0-4.0.0-beta.44",
    "@girs/gjs": "^4.0.0-beta.44",
    "@girs/glib-2.0": "^2.88.0-4.0.0-beta.44",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "esbuild": "^0.27.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
